# ─── Furniva Load Test Environment ───────────────────────────────────────
# Copy this file to .env and fill in real values before running tests.
# NEVER commit the actual .env file.

# Target API URL (Local or Deployed Cloud Environment)
# Local:      http://localhost:5000
# Cloud/Prod: https://furniva-api.onrender.com
BASE_URL=http://localhost:5000

# Pre-seeded load-test user credentials (created by: node helpers/seed-test-user.js)
TEST_USER_EMAIL=loadtest@furniva.dev
TEST_USER_PASSWORD=LoadTest123!

# Default page size for product listing
PRODUCT_PAGE_SIZE=12

# Concurrency overrides for scenarios
# CONCURRENCY=1000
# MAX_VUS=1000

