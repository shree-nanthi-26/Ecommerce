# ──────────────────────────────────────────────────────────────────────────────
# Furniva Backend API — Production Environment Variables
# Copy this file to .env and provide real credentials in production.
# NEVER commit the actual .env file or real secrets to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application Environment ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (MongoDB / Atlas) ────────────────────────────────────────────────
# Local development:
# MONGO_URI=mongodb://127.0.0.1:27017/furniva
#
# Standard MongoDB Atlas SRV connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-name>.<unique-id>.mongodb.net/<database>?retryWrites=true&w=majority&appName=Furniva
MONGO_URI=mongodb://127.0.0.1:27017/furniva

# MongoDB Atlas Connection Pooling (Tuned for multi-instance deployments)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_IDLE_TIME_MS=30000

# ── Managed Redis (Rate Limiting, WAF Caching, Product Cache) ────────────────
# Use rediss:// (TLS) for managed cloud Redis (Upstash / Redis Cloud / Render Redis / AWS ElastiCache)
# Local development: redis://127.0.0.1:6379
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-redis-host.upstash.io:6379
REDIS_TLS=true
REDIS_TLS_REJECT_UNAUTHORIZED=true

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_random_key_min_32_chars

# ── CORS & Client URLs ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production:
CORS_ORIGINS=https://furniva.vercel.app,https://admin.furniva.vercel.app
CLIENT_URL=https://furniva.vercel.app

# ── Payment Gateway (Razorpay) ───────────────────────────────────────────────
# Get from Razorpay Dashboard -> Settings -> API Keys (Use Live Mode keys in production)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Media Storage (Cloudinary) ───────────────────────────────────────────────
# Get from Cloudinary Dashboard -> Product Environment Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Email Service (Transactional Emails / Password Reset / Verification) ─────
# Also supports SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM aliases
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=Furniva <no-reply@furniva.com>
